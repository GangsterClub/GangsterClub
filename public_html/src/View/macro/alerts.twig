{% macro alert(color, role, svgPath, message) %}
    <div class="flex items-start gap-4 {{ color }} text-white text-sm font-bold px-4 py-3" role="{{ role }}">
        <svg class="fill-current shrink-0 w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="{{ svgPath }}"/></svg>
        <p>{{ message }}</p>
    </div>
{% endmacro %}

{% macro error(message) %}
    {{ _self.alert(
        'bg-red-500',
        'alert',
        'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm0-4a1 1 0 0 1-2 0V7a1 1 0 0 1 2 0v6Z',
        message
    ) }}
{% endmacro %}

{% macro success(message) %}
    {{ _self.alert(
        'bg-green-500',
        'alert',
        'M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm5.676,8.237-6,5.5a1,1,0,0,1-1.383-.03l-3-3a1,1,0,1,1,1.414-1.414l2.323,2.323,5.294-4.853a1,1,0,1,1,1.352,1.474Z',
        message
    ) }}
{% endmacro %}
