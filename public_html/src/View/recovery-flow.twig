{% extends "tmpl/base.twig" %}
{% import "macro/alerts.twig" as alerts %}

{% block md %}
    <title>{{ __('recovery.page-title') }}</title>
{% endblock %}

{% block content %}
<section class="min-h-screen px-4 py-10">
    <dialog open id="recovery-flow-modal"
        class="modal-dialog backdrop:bg-black/60"
        data-pending-label="{{ __('recovery.security-action-pending') }}"
        data-failure-message="{{ __('recovery.security-action-failed') }}">
        <div class="modal-panel max-w-2xl" role="document" aria-labelledby="recovery-flow-title">
            <header class="mb-5">
                <p class="text-sm font-semibold text-amber-600">{{ __('recovery.security-step') }}</p>
                <h1 id="recovery-flow-title" class="text-2xl font-bold">
                    {% if flow.purpose == 'replace_recovery_codes' %}
                        {{ __('recovery.generate-new-title') }}
                    {% elseif flow.purpose == 'lost_authenticator_recovery' %}
                        {{ __('recovery.replace-lost-title') }}
                    {% elseif flow.purpose == 'authenticator_enrollment' %}
                        {{ __('recovery.enrollment-title') }}
                    {% else %}
                        {{ __('recovery.initial-title') }}
                    {% endif %}
                </h1>
            </header>

            <div id="recovery-flow-status" data-modal-status aria-live="polite" aria-atomic="true" tabindex="-1">
                {% for error in recovery.errors %}
                    {{ alerts.error(error) }}
                {% endfor %}
                {% for success in recovery.success %}
                    {{ alerts.success(success) }}
                {% endfor %}
            </div>

            {% if flow.state == 'email_verification_pending' %}
                <p class="mb-4">{{ __('recovery.email-code-instructions', { email: user.email }) }}</p>
                <form method="POST" data-recovery-form class="space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="verify_email" />
                    <label for="email_code" class="block font-medium">{{ __('recovery.email-code-label') }}</label>
                    <input id="email_code" name="email_code" class="field-input" inputmode="numeric"
                        maxlength="{{ flow.emailDigits }}" autocomplete="one-time-code" required autofocus />
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.continue') }}</button>
                </form>
            {% elseif flow.state == 'fresh_reauthentication_pending' %}
                <p class="mb-4">{{ __('recovery.reauthentication-instructions') }}</p>
                <form method="POST" data-recovery-form class="space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="verify_authenticator" />
                    <label for="authenticator_code" class="block font-medium">{{ __('recovery.current-authenticator-code') }}</label>
                    <input id="authenticator_code" name="authenticator_code" class="field-input" inputmode="numeric"
                        maxlength="{{ flow.digits }}" autocomplete="one-time-code" required autofocus />
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.verify') }}</button>
                </form>
            {% elseif flow.state in ['authenticator_configuration_presented', 'new_authenticator_configuration_presented'] %}
                <p class="mb-4">{{ flow.lost ? __('recovery.configure-new-warning') : __('recovery.configure-instructions') }}</p>
                {% if flow.qrCodeUrl %}
                    <img src="{{ flow.qrCodeUrl }}" alt="{{ __('recovery.qr-alt') }}" class="mb-4 h-48 w-48 rounded bg-white p-2" />
                {% endif %}
                <p class="mb-2">{{ __('recovery.secret-label') }}: <code class="font-mono">{{ flow.authenticatorSecret }}</code></p>
                {% if flow.otpauth %}
                    <p class="mb-4 break-all text-sm"><code>{{ flow.otpauth|raw }}</code></p>
                {% endif %}
                <form method="POST" data-recovery-form class="space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="verify_authenticator" />
                    <label for="authenticator_code" class="block font-medium">{{ __('recovery.new-authenticator-code') }}</label>
                    <input id="authenticator_code" name="authenticator_code" class="field-input" inputmode="numeric"
                        maxlength="{{ flow.digits }}" autocomplete="one-time-code" required autofocus />
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.verify-authenticator') }}</button>
                </form>
            {% elseif flow.state == 'recovery_code_pending' %}
                <p class="mb-4">{{ __('recovery.lost-code-instructions') }}</p>
                <form method="POST" data-recovery-form class="space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="verify_recovery_code" />
                    <label for="recovery_code" class="block font-medium">{{ __('recovery.active-recovery-code') }}</label>
                    <input id="recovery_code" name="recovery_code" class="field-input font-mono uppercase"
                        autocomplete="one-time-code" required autofocus />
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.verify-recovery-code') }}</button>
                </form>
            {% elseif flow.state == 'replacement_warning_presented' %}
                <div class="rounded border border-amber-400 bg-amber-50 p-4 text-amber-900 dark:bg-amber-950/30 dark:text-amber-100">
                    <p class="font-semibold">
                        {{ flow.lost ? __('recovery.lost-replacement-warning') : __('recovery.replacement-warning') }}
                    </p>
                    <p class="mt-2">{{ __('recovery.old-credentials-remain-active') }}</p>
                </div>
                <form method="POST" data-recovery-form class="mt-4 space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="confirm_replacement" />
                    <label class="flex items-start gap-2">
                        <input type="checkbox" name="confirm_replacement" value="1" required />
                        <span>{{ __('recovery.confirm-replacement-label') }}</span>
                    </label>
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.continue') }}</button>
                </form>
            {% elseif flow.state in [
                'recovery_codes_presented_unacknowledged',
                'replacement_codes_presented_unacknowledged',
                'new_recovery_codes_presented_unacknowledged'
            ] %}
                <div class="rounded border border-red-400 bg-red-50 p-4 text-red-900 dark:bg-red-950/30 dark:text-red-100">
                    <p class="font-bold">{{ __('recovery.save-codes-warning') }}</p>
                    <p class="mt-2">{{ __('recovery.permanent-lockout-warning') }}</p>
                </div>
                {% if flow.codes %}
                    <ol class="my-5 grid gap-2 rounded border border-gray-300 p-4 font-mono text-lg sm:grid-cols-2 dark:border-gray-700"
                        aria-label="{{ __('recovery.codes-list-label') }}">
                        {% for code in flow.codes %}
                            <li><code>{{ code }}</code></li>
                        {% endfor %}
                    </ol>
                {% else %}
                    <p class="my-5 rounded border border-amber-400 p-4">{{ __('recovery.codes-not-redisplayed') }}</p>
                {% endif %}
                <form method="POST" data-recovery-form class="space-y-4">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="acknowledge" />
                    <label class="flex items-start gap-2">
                        <input type="checkbox" name="saved_codes" value="1" required />
                        <span>{{ __('recovery.saved-codes-acknowledgement') }}</span>
                    </label>
                    <button class="btn-primary w-full" type="submit">{{ __('recovery.activate') }}</button>
                </form>
                <form method="POST" data-recovery-form class="mt-3">
                    {{ csrf_field() }}
                    <input type="hidden" name="action" value="codes_unavailable" />
                    <button class="text-sm underline" type="submit">{{ __('recovery.codes-unavailable-action') }}</button>
                </form>
            {% else %}
                <p>{{ __('recovery.invalid-state') }}</p>
            {% endif %}

            <form method="POST" data-recovery-form class="mt-6 border-t border-gray-300 pt-4 dark:border-gray-700">
                {{ csrf_field() }}
                <input type="hidden" name="action" value="cancel" />
                <button class="btn-secondary w-full" type="submit">{{ __('recovery.cancel') }}</button>
            </form>
        </div>
    </dialog>
</section>
{% endblock %}

{% block js %}
    <script src="{{ docRoot }}js/recovery-flow.js" defer></script>
{% endblock %}
