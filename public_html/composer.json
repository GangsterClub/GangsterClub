{
    "name": "gangsterclub/gco",
    "type": "project",
    "description": "GangsterClub is a free text based online role playing game. Can you manage becoming the best gangster?",
    "keywords": [
        "php",
        "mysql",
        "twig"
    ],
    "homepage": "https://gcov0.gangsterclub.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Carrein",
            "email": "michael.carrein@hotmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.1",
        "phpmailer/phpmailer": "^7.1.1",
        "spomky-labs/otphp": "^11.5.0",
        "twig/twig": "^3.28.0",
        "chillerlan/php-qrcode": "^6.0"
    },
    "suggest": {
        "symfony/yaml": "PHP's yaml_parse_file() fallback package"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "src\\": "src/"
        }
    },
    "scripts": {
        "setup": [
            "@php run.php --setup"
        ],
        "test": [
            "@php tests/AccountAuthenticatorCharacterizationTest.php",
            "@php tests/AccountRedirectStatusTest.php",
            "@php tests/AuthenticationRateLimitServiceTest.php",
            "@php tests/AuthenticatorSecurityControllerTest.php",
            "@php tests/AuthEntryControllerTest.php",
            "@php tests/AuthEntryServiceTest.php",
            "@php tests/BearerAuthJWTTest.php",
            "@php tests/CsrfMiddlewareTest.php",
            "@php tests/ContainerProviderTest.php",
            "@php tests/EmailTOTPServiceTest.php",
            "@php tests/JWTServiceTest.php",
            "@php tests/QueryBuilderSqlGenerationTest.php",
            "@php tests/RecoveryFeatureHttpTest.php",
            "@php tests/SecurityFoundationTest.php",
            "@php tests/SecurityMigrationTest.php",
            "@php tests/SessionServiceConstructorProductionTest.php",
            "@php tests/SessionServiceConstructorNonProductionTest.php",
            "@php tests/SessionServiceConstructorDevelopmentTest.php"
        ],
        "check": [
            "@test"
        ]
    }
}
